# Ambiente virtual e caches locais (a imagem instala as próprias dependências)
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Controle de versão e editores
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db

# Segredos: variáveis vão pelo painel do Render ou por -e/--env-file
.env
.env.*

# Certificado corporativo: entra no build só via --secret, nunca no contexto
*.crt
*.cer
*.pem

# Pesos e saídas do YOLO: o peso base é baixado durante o build.
# Exceção: o best.pt do fine-tuning não existe em lugar nenhum para baixar —
# ele é produzido pelo fine_tuning.py e precisa entrar no contexto do build.
*.pt
!best.pt
runs/
*.log

# Arquivos do próprio Docker e documentação
Dockerfile
docker-compose.yml
.dockerignore
*.md

# tests/, pytest.ini e imagens/ ficam: o estágio "test" precisa deles.
# O estágio "runtime" copia apenas config.py e detectar_endpoint.py.
